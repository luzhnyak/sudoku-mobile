{
  "expo": {
    "name": "Sudoku",
    "slug": "sudoku-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "sudokumobile",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.luzhnyak.sudoku",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#13378F"
      },
      "allowBackup": false,
      "predictiveBackGestureEnabled": true
    },
    "ios": { "bundleIdentifier": "com.luzhnyak.sudoku" },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#13378F",
          "image": "./assets/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ]
    ],
    "updates": { "enabled": false }
  }
}
